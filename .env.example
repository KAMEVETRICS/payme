# Copy to .env and fill in. Never commit .env.
# Payer currently runs on Arc TESTNET. Do not send real funds to these wallets.

# --- Arc ---
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# A plain key that deploys the contracts (npm run deploy:testnet) and funds the
# Circle wallets with testnet gas (npm run circle:setup). Not used by the running app.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# --- Circle (console.circle.com, testnet keys) ---
CIRCLE_API_KEY=
# Filled in by npm run circle:setup:
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_AGENT_WALLET_ID=
CIRCLE_AGENT_ADDRESS=
# A developer-controlled stand-in owner, used only by circle:setup to create a test vault.
CIRCLE_OWNER_WALLET_ID=
CIRCLE_OWNER_ADDRESS=
# From Wallets -> User Controlled -> Configurator (owner sign-in by email code).
NEXT_PUBLIC_CIRCLE_APP_ID=

# --- Models (openrouter.ai/keys) ---
# Any OpenRouter model that supports structured outputs and file input.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# --- App ---
# Long random strings, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Protects /api/cron/scheduler if a hosted cron job runs the scheduler.
CRON_SECRET=

# --- Invoice email ---
# The domain invoices are sent to: each business gets <name>-<key>@INBOUND_DOMAIN.
INBOUND_DOMAIN=
# Alternative for Postmark's shared inbound address (abc123@inbound.postmarkapp.com):
# businesses then get abc123+<key>@inbound.postmarkapp.com. Leave empty when INBOUND_DOMAIN is set.
INBOUND_ADDRESS=
# Shared with the email Worker (as its WEBHOOK_SECRET) or with Postmark's webhook URL.
INBOUND_WEBHOOK_SECRET=

# --- Alerts (optional) ---
# Emails whoever runs Payer when the agent wallet is low on gas. Uses Resend's API
# (a key with sending access; the From domain must be verified in Resend).
RESEND_API_KEY=
OPS_EMAIL=
OPS_FROM=Payer <alerts@deplace.space>
